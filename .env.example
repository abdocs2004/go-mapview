# --- Payload needs a database. Pick ONE approach ---

# (B) SQLite — easiest for local dev (no Docker). File is created next to payload.config.ts.
USE_SQLITE=false

# (A) PostgreSQL — use for production or when you want Docker Postgres:
# USE_SQLITE=false
# DATABASE_URI=postgresql://postgres:password@127.0.0.1:5432/gomap
# Then run: npm run db:up

# Optional: custom SQLite path (must start with file:)
# SQLITE_URL=file:./payload.sqlite

# Payload CMS (required — use a long random string in production)
PAYLOAD_SECRET=your-super-secret-key-change-this

# Next.js
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

NODE_ENV=development
