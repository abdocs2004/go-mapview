{
  "name": "gomapview",
  "version": "1.0.0",
  "description": "Premium immersive virtual tour platform inspired by Matterport",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true});try{require('fs').rmSync('node_modules/.cache',{recursive:true,force:true})}catch(e){}\"",
    "db:up": "docker compose up -d postgres",
    "build": "npx payload migrate:create db_init || true && npx payload migrate || true && next build",
    "start": "next start",
    "lint": "next lint",
    "payload": "payload",
    "generate:importmap": "payload generate:importmap",
    "generate:types": "payload generate:types"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "^3.84.1",
    "@payloadcms/db-sqlite": "^3.84.1",
    "@payloadcms/next": "^3.84.1",
    "@payloadcms/richtext-lexical": "^3.84.1",
    "autoprefixer": "^10.4.16",
    "axios": "^1.6.2",
    "clsx": "^2.0.0",
    "date-fns": "^2.30.0",
    "express": "^4.18.2",
    "framer-motion": "^11.0.0",
    "graphql": "^16.10.0",
    "gsap": "^3.15.0",
    "html-react-parser": "^5.0.0",
    "lucide-react": "^0.294.0",
    "next": "^15.4.11",
    "next-intl": "^3.0.0",
    "next-themes": "^0.2.1",
    "node-fetch": "^2.7.0",
    "payload": "^3.84.1",
    "payload-cloudinary": "^2.3.0",
    "postcss": "^8.4.31",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.50.0",
    "sharp": "^0.33.1",
    "tailwind-merge": "^2.2.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^8.56.0",
    "eslint-config-next": "^15.4.11"
  }
}
