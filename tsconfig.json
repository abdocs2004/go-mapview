{
  "compilerOptions": {
    "target": "ES2022",

    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],

    "jsx": "preserve",

    "module": "ESNext",

    "moduleResolution": "node",

    "baseUrl": ".",

    "paths": {
      "@payload-config": [
        "./payload.config.ts"
      ],

      "@/*": [
        "./src/*"
      ],

      "@components/*": [
        "./src/components/*"
      ],

      "@app/*": [
        "./src/app/*"
      ],

      "@lib/*": [
        "./src/lib/*"
      ],

      "@hooks/*": [
        "./src/hooks/*"
      ],

      "@types/*": [
        "./src/types/*"
      ],

      "@collections/*": [
        "./src/collections/*"
      ],

      "@globals/*": [
        "./src/globals/*"
      ]
    },

    "allowJs": true,

    "strict": true,

    "noEmit": true,

    "esModuleInterop": true,

    "skipLibCheck": true,

    "forceConsistentCasingInFileNames": true,

    "resolveJsonModule": true,

    "isolatedModules": true,

    "incremental": true,

    "plugins": [
      {
        "name": "next"
      }
    ]
  },

  "include": [
    "*/.ts",
    "*/.tsx",
    "next-env.d.ts",
    ".next/types/*/.ts"
  ],

  "exclude": [
    "node_modules"
  ]
}
